# Windows batch files must keep CRLF line endings, or cmd.exe can misread labels and multi-byte text.
*.bat text eol=crlf
# The macOS launcher is a bash script and must keep LF line endings.
*.command text eol=lf
# The Gradle wrapper for macOS/Linux is a shell script and must keep LF line endings.
android/gradlew text eol=lf
