{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fantasy-simulator://schemas/story-arc/2",
  "title": "Fantasy Simulator Story Arc v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "summary", "unresolved"],
  "properties": {
    "schema_version": {"const": "story-arc/2"},
    "title": {"type": "string", "minLength": 1, "maxLength": 20000},
    "summary": {"type": "string", "minLength": 1, "maxLength": 20000},
    "unresolved": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 4000}}
  },
  "examples": [{"schema_version": "story-arc/2", "title": "第1—25节点", "summary": "这段旅程的完整梗概，包含其中的关键事件。", "unresolved": ["答应替潮隼一号船长打听失踪货船的下落，尚未回复"]}]
}
